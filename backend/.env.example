# Copy to .env and fill values
MONGO_URI=mongodb://127.0.0.1:27017/messiora
PORT=5000
# Frontend origin(s) (set to your Vite dev server(s) or production URL). You can provide
# a single value `CLIENT_URL` or multiple comma-separated origins via `CLIENT_URLS`.
# Example: CLIENT_URLS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173
CLIENT_URLS=
